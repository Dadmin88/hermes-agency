# AWS ECS Fargate deployment environment
# Copy to .env.aws and fill in values before deploying
#
# Secrets (DATABASE_URL, BETTER_AUTH_SECRET, ANTHROPIC_API_KEY, OPENAI_API_KEY,
# GITHUB_TOKEN) are injected via AWS Secrets Manager — do NOT set them here.

# Deployment mode
HERMES_FABRIC_DEPLOYMENT_MODE=authenticated
HERMES_FABRIC_DEPLOYMENT_EXPOSURE=public
HERMES_FABRIC_PUBLIC_URL=https://fabric.example.com

# Server
HOST=0.0.0.0
PORT=3100
NODE_ENV=production
SERVE_UI=true

# HermesFabric paths
HERMES_FABRIC_HOME=/fabric
HERMES_FABRIC_INSTANCE_ID=default
HERMES_FABRIC_CONFIG=/fabric/instances/default/config.json

# Auto-apply migrations on startup
HERMES_FABRIC_MIGRATION_AUTO_APPLY=true

# Enable heartbeat scheduler for remote agents
HEARTBEAT_SCHEDULER_ENABLED=true

# Post-deploy hardening (uncomment after first user signs up)
# HERMES_FABRIC_AUTH_DISABLE_SIGN_UP=true
