[Unit]
Description=Hermes Agency Pool Manager
After=network.target

[Service]
Type=simple
User=dadmin
WorkingDirectory=%h/Hermes_Agency/hermes-agency/pool
ExecStart=/usr/bin/python3 %h/Hermes_Agency/hermes-agency/pool/service.py
Restart=always
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_HOME=%h/.hermes

[Install]
WantedBy=default.target
