{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Agency Model Bake-off Result",
  "type": "object",
  "required": ["model_set", "profile", "provider", "model", "task_id", "score"],
  "properties": {
    "model_set": {"type": "string"},
    "profile": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "task_id": {"type": "string"},
    "score": {
      "type": "object",
      "properties": {
        "correctness": {"type": "integer", "minimum": 1, "maximum": 5},
        "instruction_following": {"type": "integer", "minimum": 1, "maximum": 5},
        "code_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "safety": {"type": "integer", "minimum": 1, "maximum": 5},
        "test_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "cleanup_burden": {"type": "integer", "minimum": 1, "maximum": 5},
        "latency": {"type": "number", "minimum": 0},
        "estimated_cost": {"type": "number", "minimum": 0},
        "human_preference": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
